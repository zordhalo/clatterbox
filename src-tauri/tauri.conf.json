{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clatterbox",
  "identifier": "dev.zordhalo.clatterbox",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/packs/": "packs/"
    },
    "macOS": {
      "minimumSystemVersion": "14.2"
    },
    "licenseFile": "../LICENSE"
  }
}
